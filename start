#!/usr/bin/env bash
#
# One command to run the whole thing.
#
#     ./start          (or just `start` inside the VS Code terminal)
#
# Creates the virtual environment if it is missing, builds the Quran data if it
# is missing, starts the API with the models preloaded, waits until it is
# genuinely ready, and opens the demo page with the microphone.
#
set -euo pipefail

cd "$(dirname "$0")"

PORT="${PORT:-8000}"
HOST="${HOST:-127.0.0.1}"
URL="http://${HOST}:${PORT}/"
VENV=".venv"
PY="${VENV}/bin/python"

bold()  { printf "\033[1m%s\033[0m\n" "$1"; }
info()  { printf "  \033[2m%s\033[0m\n" "$1"; }
ok()    { printf "  \033[32m✓\033[0m %s\n" "$1"; }
warn()  { printf "  \033[33m!\033[0m %s\n" "$1"; }
die()   { printf "  \033[31m✗\033[0m %s\n" "$1" >&2; exit 1; }

echo
bold "Quran Recitation API"

# ── 1. environment ──────────────────────────────────────────────────────────
if [ ! -x "$PY" ]; then
  info "creating the virtual environment (first run only)…"
  python3 -m venv "$VENV" || die "could not create $VENV - is python3 installed?"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r requirements-dev.txt || die "dependency install failed"
  ok "environment created"
else
  ok "environment ready"
fi

if ! "$PY" -c "import fastapi, faster_whisper" >/dev/null 2>&1; then
  info "installing missing dependencies…"
  "$VENV/bin/pip" install -q -r requirements-dev.txt || die "dependency install failed"
fi

# ── 2. Quran data ───────────────────────────────────────────────────────────
if [ ! -f "data/quran/quran.json" ]; then
  info "building the Quran data asset (first run only)…"
  "$PY" scripts/prepare_quran_data.py >/dev/null || die "could not build the Quran data"
  ok "Quran data built"
else
  ok "Quran data ready"
fi

[ -f .env ] || cp .env.example .env

# ── 3. free the port ────────────────────────────────────────────────────────
if lsof -ti tcp:"$PORT" >/dev/null 2>&1; then
  warn "port $PORT is in use - stopping the old server"
  lsof -ti tcp:"$PORT" | xargs kill 2>/dev/null || true
  sleep 1
fi

# ── 4. start ────────────────────────────────────────────────────────────────
mkdir -p .run
LOG=".run/server.log"
info "starting the server (loading models - about 5 seconds)…"

PRELOAD_MODELS=true "$PY" -m uvicorn app.main:app --host "$HOST" --port "$PORT" > "$LOG" 2>&1 &
SERVER_PID=$!

cleanup() {
  echo
  info "stopping…"
  kill "$SERVER_PID" 2>/dev/null || true
  wait "$SERVER_PID" 2>/dev/null || true
  ok "stopped"
  exit 0
}
trap cleanup INT TERM

for _ in $(seq 1 90); do
  if curl -fs --max-time 2 "http://${HOST}:${PORT}/api/v1/health" >/dev/null 2>&1; then
    READY=1; break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo; tail -20 "$LOG"; die "the server exited during startup (see $LOG)"
  fi
  sleep 1
done
[ "${READY:-0}" = "1" ] || { tail -20 "$LOG"; die "the server did not become ready"; }

DEVICE=$(curl -fs "http://${HOST}:${PORT}/api/v1/health" | "$PY" -c 'import sys,json; d=json.load(sys.stdin); print(d["device"], d["compute_type"])' 2>/dev/null || echo "cpu")
ok "server ready on $DEVICE"

# ── 5. open the page ────────────────────────────────────────────────────────
if command -v open >/dev/null 2>&1;        then open "$URL"
elif command -v xdg-open >/dev/null 2>&1;  then xdg-open "$URL" >/dev/null 2>&1
else info "open $URL in your browser"; fi

echo
bold "  Recite at  $URL"
info "API docs      ${URL}docs"
info "server log    $LOG"
info "press Ctrl-C to stop"
echo

# Follow the log, minus the per-request noise.
tail -f "$LOG" | grep --line-buffered -vE '"logger": "(uvicorn.access|httpx|faster_whisper)"' &
TAIL_PID=$!
trap 'kill $TAIL_PID 2>/dev/null || true; cleanup' INT TERM
wait "$SERVER_PID"
