# ─── Quran data ────────────────────────────────────────────────────────────────
QURAN_DATA_DIR=./data/quran

# ─── ASR (Phase 2+) ────────────────────────────────────────────────────────────
# Provisional tier drives the live view. It may NEVER report a mistake.
ASR_PROVISIONAL_MODEL=hafizku/faster-whisper-tiny-ar-quran
# Committed tier is the only tier allowed to emit mistake_detected.
ASR_COMMITTED_MODEL=OdyAsh/faster-whisper-base-ar-quran
MODEL_PATH=./models
DEVICE=auto                 # auto | cpu | cuda
COMPUTE_TYPE=int8
CPU_THREADS=2               # per worker. Thread scaling is poor - do not raise blindly.
NUM_WORKERS=3

# ─── Streaming (Phase 6+) ──────────────────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=3
CONFIRM_STRATEGY=agreement  # agreement | tier_b | none
WORD_CONF_MIN=0.90

# ─── Privacy ───────────────────────────────────────────────────────────────────
STORE_AUDIO=false

LOG_LEVEL=INFO
