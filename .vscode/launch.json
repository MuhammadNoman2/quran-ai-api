{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "API server (no reload, for breakpoints)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Streaming client example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/streaming_client.py",
      "args": [
        "data/test_audio/correct/001_002_husary_1.mp3",
        "1",
        "2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Transcribe one file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_recitation.py",
      "args": [
        "--audio", "data/test_audio/correct/001_002_husary_1.mp3",
        "--surah", "1", "--ayah", "2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate accuracy",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_recitation.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
